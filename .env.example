SSH_EMAIL=
SSH_PASSWORD=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = echt reageren, 0 = alleen voorstellen via Telegram
AUTO_REAGEREN=0
SSH_MAX_ACTIEF=7
# Plekgrens op de wachtlijst; 0 = geen grens (bij te veel kamers valt de slechtste plek af).
SSH_MAX_POSITIE=0
# Alleen reageren als de deadline binnen zoveel uur valt; 0 = op elk passend aanbod.
REAGEER_VENSTER_UUR=0
# Maximaal zoveel minuten fietsen naar Utrecht Centraal (geschat, zie kamerbot/afstand.py). 0 = uit.
MAX_FIETSMINUTEN=10
# Taalmodel dat het verhaaltje leest (past je bij het huis, hoe laat is het hospiteren). Leeg = uit.
ANTHROPIC_API_KEY=
# Optioneel: wie je bent, in één zin. Leeg = standaardprofiel (zie kamerbot/beoordeling.py).
PROFIEL=
# Je leeftijd: huizen die "18 t/m 22" of "vanaf 23" zoeken, worden hierop gecontroleerd. 0 = onbekend.
# Na je verjaardag ophogen.
LEEFTIJD=24
# Hospiteeravonden in je agenda. Zelfde sleutel als de ritbot (JSON op één regel), agenda delen met
# het client_email daaruit ("Wijzigingen aanbrengen in afspraken"). Beide leeg = uit.
GOOGLE_SERVICE_ACCOUNT_JSON=
GCAL_AGENDA_ID=
